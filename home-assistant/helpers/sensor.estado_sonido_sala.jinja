{# Ayudante «Sensor de plantilla»
   Ajustes > Dispositivos y servicios > Ayudantes > + Crear ayudante > Plantilla > Sensor de plantilla
   Nombre: Estado sonido sala   (así el id queda sensor.estado_sonido_sala)
   Plantilla de estado: todo este fichero. Unidad, clase y clase de estado: vacíos. #}
{% set amp = is_state('switch.sala_principal_amplificador_audio', 'on') %}
{% set sub = is_state('switch.sala_principal_subwoofer', 'on') %}
{% if is_state('script.encender_sala', 'on') or is_state('script.encender_musica', 'on') %}arrancando
{% elif amp and sub %}listo
{% elif not amp and not sub %}apagado
{% else %}incompleto
{% endif %}
