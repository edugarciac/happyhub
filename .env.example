# n8n Webhook Configuration
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/reservation-request
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/reservation-request

# AWS Configuration
# Note: Use .env.local for actual AWS credentials (ignored by git)
AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=your_account_id
AWS_IAM_USER=your_iam_username
AWS_PROFILE=happyhub
S3_BUCKET=your-s3-bucket
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Airtable Configuration
AIRTABLE_PERSONAL_ACCESS_TOKEN=your_airtable_token
AIRTABLE_BASE_ID=your_base_id
AIRTABLE_TABLE_ID=your_table_id

# Google Calendar Configuration (for availability checking)
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Google OAuth (for Google Sign-In)
GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abcd1234efgh5678ijkl
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true

# Claude API (optional for AI features)
CLAUDE_API_KEY=sk-ant-...

# Database (if using direct DB instead of n8n)
DATABASE_URL=postgresql://user:password@host:5432/happyhub

# Security
JWT_SECRET=your-jwt-secret-here

# WhatsApp Cloud API (Meta) - Free: 1000 conversations/month
# Get these from Meta Business Suite > developers.facebook.com
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx

# Admin WhatsApp (your phone number to receive notifications)
ADMIN_WHATSAPP_NUMBER=+34666666666

# Cron API Key (for automated reminders)
CRON_API_KEY=your-secure-cron-api-key
