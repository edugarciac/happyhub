  "curlExamples": {
    "reservaSimple": "curl -X POST https://n8n-happyhub-n8n.c13yv5.easypanel.host/webhook/reserva-happyhub -H \"Content-Type: application/json\" -d '{\"name\":\"María García\",\"email\":\"maria.garcia@example.com\",\"phone\":\"+34612345678\",\"eventType\":\"Cumpleaños\",\"date\":\"2025-01-15\",\"time\":\"17:00\",\"guests\":25,\"duration\":\"4\",\"extras\":[],\"paymentMethod\":\"stripe\",\"totalPrice\":450}'",
    "reservaConflicto": "curl -X POST https://n8n-happyhub-n8n.c13yv5.easypanel.host/webhook/reserva-happyhub -H \"Content-Type: application/json\" -d '{\"name\":\"Test User\",\"email\":\"test@example.com\",\"phone\":\"+34600000000\",\"eventType\":\"Test\",\"date\":\"2025-01-15\",\"time\":\"17:00\",\"guests\":10,\"duration\":\"2\",\"totalPrice\":200}'"
  },
  "postmanCollection": {
    "info": {
      "name": "HappyHub - n8n Reservas API",
      "description": "Colección de tests para el sistema de reservas de HappyHub",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
      {
        "name": "Crear Reserva - Cumpleaños",
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"name\": \"María García\",\n  \"email\": \"maria.garcia@example.com\",\n  \"phone\": \"+34612345678\",\n  \"eventType\": \"Cumpleaños\",\n  \"date\": \"2025-01-15\",\n  \"time\": \"17:00\",\n  \"guests\": 25,\n  \"duration\": \"4\",\n  \"extras\": [],\n  \"paymentMethod\": \"stripe\",\n  \"totalPrice\": 450\n}"
          },
          "url": {
            "raw": "https://n8n-happyhub-n8n.c13yv5.easypanel.host/webhook/reserva-happyhub",
            "protocol": "https",
            "host": ["n8n-happyhub-n8n", "c13yv5", "easypanel", "host"],
            "path": ["webhook", "reserva-happyhub"]
          }
        }
      }
    ]
  },
  "validationRules": {
    "required": ["name", "email", "phone", "eventType", "date", "time", "guests", "totalPrice"],
    "optional": ["duration", "extras", "paymentMethod", "message"],
    "formats": {
      "date": "YYYY-MM-DD",
      "time": "HH:MM",
      "phone": "+34XXXXXXXXX",
      "email": "valid@email.com"
    },
    "constraints": {
      "guests": {
        "min": 1,
        "max": 200
      },
      "duration": {
        "min": 2,
        "max": 8,
        "default": 4
      },
      "totalPrice": {
        "min": 0,
        "currency": "EUR"
      }
    }
  },
  "expectedResponses": {
    "success": {
      "status": 200,
      "body": {
        "success": true,
        "message": "Reserva creada exitosamente",
        "reservationId": "rec123abc456",
        "paymentLink": "https://buy.stripe.com/...",
        "calendarEventId": "abc123xyz789",
        "fecha": "15/01/2025",
        "hora": "17:00h"
      }
    },
    "conflict": {
      "status": 409,
      "body": {
        "success": false,
        "error": "Lo siento, la fecha y hora indicada ya está reservada.",
        "message": "Lo siento, la fecha y hora indicada ya está reservada.",
        "fechaSolicitada": "15/01/2025",
        "horaSolicitada": "17:00h"
      }
    },
    "badRequest": {
      "status": 400,
      "body": {
        "success": false,
        "error": "Faltan campos obligatorios"
      }
    },
    "serverError": {
      "status": 500,
      "body": {
        "success": false,
        "error": "Error al procesar la reserva"
      }
    }
  }
}
