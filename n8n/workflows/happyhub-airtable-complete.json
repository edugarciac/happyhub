    {
      "parameters": {
        "functionCode": "const airtableRecord = items[0].json;\nconst originalData = items[1].json;\n\nconst recordId = airtableRecord.id;\nconst recordNumber = airtableRecord.fields['Reservation ID'] || recordId.substring(3, 10);\n\nconst airtableUrl = `https://airtable.com/${process.env.AIRTABLE_BASE_ID}/${process.env.AIRTABLE_TABLE_ID}/${recordId}`;\n\nreturn [{\n  json: {\n    reservationId: recordNumber,\n    airtableRecordId: recordId,\n    airtableUrl,\n    ...originalData\n  }\n}];"
      },
      "name": "Preparar Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 400]
    },
