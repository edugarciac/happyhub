      "parameters": {
        "fromEmail": "noreply@happyhub.es",
        "toEmail": "hola@happyhub.es",
        "subject": "🔔 Nueva Solicitud #{{$json.reservationId}} - Requiere Aprobación",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #f9fafb;\">\n  <div style=\"background: linear-gradient(135deg, #FF6B35 0%, #00BCD4 100%); padding: 30px; border-radius: 10px 10px 0 0; text-align: center;\">\n    <h1 style=\"color: white; margin: 0; font-size: 28px;\">Nueva Solicitud de Reserva</h1>\n    <p style=\"color: white; margin: 10px 0 0 0; font-size: 16px;\">ID: #{{$json.reservationId}}</p>\n  </div>\n  \n  <div style=\"background: white; padding: 30px; border-radius: 0 0 10px 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);\">\n    <h2 style=\"color: #FF6B35; margin-top: 0;\">📋 Detalles del Evento</h2>\n    \n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n      <tr style=\"background: #f9fafb;\">\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb; font-weight: bold;\">📅 Fecha:</td>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb;\">{{$json.formattedDate}}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb; font-weight: bold;\">⏰ Franja:</td>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb;\">{{$json.timeSlotLabel}}</td>\n      </tr>\n      <tr style=\"background: #f9fafb;\">\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb; font-weight: bold;\">🎉 Tipo:</td>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb;\">{{$json.eventTypeLabel}}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb; font-weight: bold;\">👥 Invitados:</td>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb;\">{{$json.guests}} personas</td>\n      </tr>\n      <tr style=\"background: #f9fafb;\">\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb; font-weight: bold;\">💰 Precio:</td>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb; color: #FF6B35; font-size: 18px; font-weight: bold;\">{{$json.totalPrice}}€</td>\n      </tr>\n    </table>\n    \n    <h2 style=\"color: #FF6B35; margin-top: 30px;\">👤 Información del Cliente</h2>\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\n      <tr style=\"background: #f9fafb;\">\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb; font-weight: bold;\">Nombre:</td>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb;\">{{$json.name}}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb; font-weight: bold;\">Email:</td>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb;\"><a href=\"mailto:{{$json.email}}\" style=\"color: #00BCD4;\">{{$json.email}}</a></td>\n      </tr>\n      <tr style=\"background: #f9fafb;\">\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb; font-weight: bold;\">Teléfono:</td>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb;\"><a href=\"tel:{{$json.phone}}\" style=\"color: #00BCD4;\">{{$json.phone}}</a></td>\n      </tr>\n      <tr>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb; font-weight: bold;\">Pago:</td>\n        <td style=\"padding: 12px; border: 1px solid #e5e7eb;\">{{$json.paymentMethodLabel}}</td>\n      </tr>\n    </table>\n    \n    <div style=\"margin: 30px 0; text-align: center;\">\n      <a href=\"{{$json.airtableUrl}}\" style=\"display: inline-block; background: linear-gradient(135deg, #FF6B35 0%, #ff8f6b 100%); color: white; padding: 15px 40px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 16px; box-shadow: 0 4px 6px rgba(255,107,53,0.3);\">✅ Abrir en Airtable</a>\n    </div>\n    \n    <div style=\"background: #f3f4f6; padding: 15px; border-radius: 8px;\">\n      <p style=\"margin: 0; color: #6b7280; font-size: 14px; text-align: center;\">Abre Airtable para aprobar o rechazar esta solicitud. Una vez aprobada, se creará automáticamente el evento en Google Calendar.</p>\n    </div>\n  </div>\n  \n  <div style=\"text-align: center; margin-top: 20px; color: #9ca3af; font-size: 12px;\">\n    <p>HappyHub - C/ Rovellat, 25, Esplugues de Llobregat</p>\n    <p>📞 624 645 517 | 📧 hola@happyhub.es</p>\n  </div>\n</div>",
        "options": {}
      },
