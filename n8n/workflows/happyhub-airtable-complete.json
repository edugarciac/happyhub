{
  "name": "HappyHub - Airtable Complete Workflow",
  "nodes": [
    {
      "parameters": {
        "path": "reservation-request",
        "options": {
          "responseMode": "responseNode"
        },
        "httpMethod": "POST"
      },
      "name": "Webhook - Nueva Solicitud",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "happyhub-airtable-reservation"
    },
    {
      "parameters": {
        "functionCode": "const data = items[0].json.body || items[0].json;\n\nconst eventDate = new Date(data.date);\n\nconst timeSlots = {\n  morning: { start: '11:00:00', end: '14:30:00', label: 'Mañana (11:00-14:30)' },\n  afternoon: { start: '16:30:00', end: '20:30:00', label: 'Tarde (16:30-20:30)' },\n  night: { start: '22:00:00', end: '02:00:00', label: 'Noche (22:00-02:00)' }\n};\n\nconst slot = timeSlots[data.timeSlot];\nif (!slot) {\n  throw new Error('Invalid timeSlot: ' + data.timeSlot);\n}\n\nconst timezone = 'Europe/Madrid';\nconst startDateTime = data.date + 'T' + slot.start + '+01:00';\nlet endDateTime = data.date + 'T' + slot.end + '+01:00';\n\nif (data.timeSlot === 'night') {\n  const nextDay = new Date(eventDate);\n  nextDay.setDate(nextDay.getDate() + 1);\n  const nextDayStr = nextDay.toISOString().split('T')[0];\n  endDateTime = nextDayStr + 'T' + slot.end + '+01:00';\n}\n\nconst formattedDate = eventDate.toLocaleDateString('es-ES', {\n  weekday: 'long',\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric'\n});\n\nconst paymentLabels = {\n  card: 'Tarjeta',\n  bizum: 'Bizum',\n  cash: 'Efectivo'\n};\n\nconst eventTypeLabels = {\n  'cumpleaños': 'Cumpleaños',\n  'celebracion-familiar': 'Celebración familiar',\n  'eventos-amigos': 'Eventos con amigos',\n  'eventos-colegio-trabajo': 'Eventos de colegio o trabajo',\n  'taller': 'Taller',\n  'otros': 'Otros'\n};\n\nconst result = {\n  name: data.name,\n  email: data.email,\n  phone: data.phone,\n  eventType: data.eventType,\n  date: data.date,\n  timeSlot: data.timeSlot,\n  guests: data.guests,\n  extras: data.extras,\n  paymentMethod: data.paymentMethod,\n  message: data.message,\n  totalPrice: data.totalPrice,\n  startDateTime: startDateTime,\n  endDateTime: endDateTime,\n  timeSlotLabel: slot.label,\n  formattedDate: formattedDate,\n  paymentMethodLabel: paymentLabels[data.paymentMethod] || data.paymentMethod,\n  eventTypeLabel: eventTypeLabels[data.eventType] || data.eventType,\n  calendarId: 'hola@happyhub.es'\n};\n\nreturn [{ json: result }];"
      },
      "name": "Preparar Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "calendar": "={{$json.calendarId}}",
        "operation": "getAll",
        "returnAll": false,
        "limit": 100,
        "options": {
          "timeMin": "={{$json.startDateTime}}",
          "timeMax": "={{$json.endDateTime}}"
        }
      },
      "name": "Google Calendar - Verificar Disponibilidad",
