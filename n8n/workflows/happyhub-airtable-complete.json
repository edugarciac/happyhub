        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n  <div style=\"background: linear-gradient(135deg, #FF6B35 0%, #00BCD4 100%); padding: 30px; border-radius: 10px; text-align: center; margin-bottom: 30px;\">\n    <h1 style=\"color: white; margin: 0; font-size: 32px;\">✅ ¡Solicitud Recibida!</h1>\n  </div>\n  \n  <div style=\"background: white; padding: 30px; border: 1px solid #e5e7eb; border-radius: 10px;\">\n    <p style=\"font-size: 18px; color: #374151;\">Hola <strong style=\"color: #FF6B35;\">{{$json.name}}</strong>,</p>\n    \n    <p style=\"font-size: 16px; color: #6b7280; line-height: 1.6;\">Hemos recibido tu solicitud de reserva correctamente.</p>\n    \n    <div style=\"background: #f9fafb; padding: 20px; border-radius: 8px; margin: 20px 0; border-left: 4px solid #FF6B35;\">\n      <p style=\"margin: 0; font-size: 14px; color: #6b7280;\">Número de solicitud</p>\n      <p style=\"margin: 5px 0 0 0; font-size: 24px; font-weight: bold; color: #FF6B35;\">#{{$json.reservationId}}</p>\n    </div>\n    \n    <h3 style=\"color: #FF6B35; margin-top: 30px;\">📋 Resumen de tu solicitud</h3>\n    <ul style=\"color: #6b7280; line-height: 1.8;\">\n      <li><strong>Fecha:</strong> {{$json.formattedDate}}</li>\n      <li><strong>Franja:</strong> {{$json.timeSlotLabel}}</li>\n      <li><strong>Invitados:</strong> {{$json.guests}} personas</li>\n      <li><strong>Tipo de evento:</strong> {{$json.eventTypeLabel}}</li>\n    </ul>\n    \n    <div style=\"background: #fef3c7; padding: 20px; border-radius: 8px; margin: 30px 0; border-left: 4px solid #f59e0b;\">\n      <p style=\"margin: 0; color: #92400e; font-size: 14px; line-height: 1.6;\">\n        <strong>⏳ Pendiente de revisión</strong><br>\n        Nuestro equipo revisará tu solicitud en las próximas <strong>24 horas</strong> y te contactaremos para confirmar todos los detalles.\n      </p>\n    </div>\n    \n    <h3 style=\"color: #00BCD4;\">📝 Próximos pasos</h3>\n    <ol style=\"color: #6b7280; line-height: 1.8;\">\n      <li>Revisaremos tu solicitud</li>\n      <li>Te contactaremos por teléfono o email</li>\n      <li>Te enviaremos el enlace de pago</li>\n      <li>Confirmarás con el depósito del 30%</li>\n    </ol>\n    \n    <p style=\"font-size: 16px; color: #6b7280; margin-top: 30px;\">\n      Si tienes alguna pregunta, no dudes en contactarnos:\n    </p>\n    \n    <div style=\"text-align: center; margin: 30px 0;\">\n      <a href=\"tel:624645517\" style=\"display: inline-block; background: #00BCD4; color: white; padding: 12px 30px; text-decoration: none; border-radius: 8px; margin: 5px; font-weight: bold;\">📞 624 645 517</a>\n      <a href=\"mailto:hola@happyhub.es\" style=\"display: inline-block; background: #FF6B35; color: white; padding: 12px 30px; text-decoration: none; border-radius: 8px; margin: 5px; font-weight: bold;\">📧 Email</a>\n    </div>\n    \n    <p style=\"font-size: 16px; color: #374151; margin-top: 30px;\">\n      Saludos,<br>\n      <strong style=\"color: #FF6B35;\">El equipo de HappyHub</strong>\n    </p>\n  </div>\n  \n  <div style=\"text-align: center; margin-top: 30px; color: #9ca3af; font-size: 12px;\">\n    <p>HappyHub - Espacios para celebraciones</p>\n    <p>C/ Rovellat, 25, 08950 Esplugues de Llobregat (Barcelona)</p>\n  </div>\n</div>",
        "options": {}
      },
