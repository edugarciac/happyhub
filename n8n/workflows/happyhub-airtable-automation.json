{
  "name": "HappyHub - Airtable Status Automation",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "base": {
          "__rl": true,
          "value": "appAj3N7bMGIVBagd",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "tblGakVr6paaokq9N",
          "mode": "id"
        },
        "options": {
          "filterByFormula": "AND({Status} = 'Approved', {Google Calendar ID} = BLANK())"
        }
      },
      "name": "Airtable - Detectar Aprobadas",
      "type": "n8n-nodes-base.airtableTrigger",
      "typeVersion": 2,
      "position": [250, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "1",
          "name": "Airtable HappyHub"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const record = items[0].json.fields;\n\n// Formatear fecha para Google Calendar\nconst eventDate = new Date(record['Evento - Fecha']);\nconst timeSlotMapping = {\n  'Mañana (11:00-14:30)': { start: '11:00:00', end: '14:30:00' },\n  'Tarde (16:30-20:30)': { start: '16:30:00', end: '20:30:00' },\n  'Noche (22:00-02:00)': { start: '22:00:00', end: '02:00:00' }\n};\n\nconst slot = timeSlotMapping[record['Evento - Franja']];\nconst dateStr = record['Evento - Fecha'];\nconst startDateTime = `${dateStr}T${slot.start}`;\nlet endDateTime = `${dateStr}T${slot.end}`;\n\n// Si es noche, el final es al día siguiente\nif (record['Evento - Franja'] === 'Noche (22:00-02:00)') {\n  const nextDay = new Date(eventDate);\n  nextDay.setDate(nextDay.getDate() + 1);\n  endDateTime = `${nextDay.toISOString().split('T')[0]}T${slot.end}`;\n}\n\nreturn [{\n  json: {\n    recordId: items[0].json.id,\n    nombre: record['Cliente - Nombre'],\n    email: record['Cliente - Email'],\n    telefono: record['Cliente - Teléfono'],\n    eventoTipo: record['Evento - Tipo'],\n    eventoFecha: record['Evento - Fecha'],\n    eventoFranja: record['Evento - Franja'],\n    invitados: record['Evento - Invitados'],\n    extras: record['Extras'] || '',\n    startDateTime,\n    endDateTime,\n    calendarId: 'happyhub.rovellat@gmail.com'\n  }\n}];"
      },
      "name": "Preparar Datos Calendar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "calendar": "={{$json.calendarId}}",
        "start": "={{$json.startDateTime}}",
        "end": "={{$json.endDateTime}}",
        "summary": "Reserva HappyHub - {{$json.nombre}}",
        "description": "=Evento: {{$json.eventoTipo}}\nInvitados: {{$json.invitados}} personas\nFranja: {{$json.eventoFranja}}\n\n👤 Cliente:\nNombre: {{$json.nombre}}\nEmail: {{$json.email}}\nTeléfono: {{$json.telefono}}\n\n🎉 Extras:\n{{$json.extras || 'Ninguno'}}\n\n---\nGestionado por HappyHub\nhappyhub.rovellat@gmail.com",
        "options": {
          "sendUpdates": "all"
        }
      },
      "name": "Google Calendar - Crear Evento",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "1",
          "name": "Google Calendar happyhub.rovellat"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "base": {
          "__rl": true,
          "value": "appAj3N7bMGIVBagd",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "tblGakVr6paaokq9N",
          "mode": "id"
        },
        "id": "={{$json.recordId}}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Google Calendar ID": "={{$json.id}}",
            "Reviewed At": "={{$now.toISO()}}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "name": "Airtable - Actualizar con Calendar ID",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2,
      "position": [850, 300],
      "credentials": {
        "airtableTokenApi": {
          "id": "1",
          "name": "Airtable HappyHub"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "noreply@happyhub.es",
        "toEmail": "={{$json.email}}",
        "subject": "🎉 ¡Reserva Aprobada! - HappyHub",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n  <div style=\"background: linear-gradient(135deg, #10b981 0%, #059669 100%); padding: 40px; border-radius: 10px; text-align: center; margin-bottom: 30px;\">\n    <div style=\"font-size: 60px; margin-bottom: 10px;\">🎉</div>\n    <h1 style=\"color: white; margin: 0; font-size: 32px;\">¡Reserva Aprobada!</h1>\n  </div>\n  \n  <div style=\"background: white; padding: 30px; border: 1px solid #e5e7eb; border-radius: 10px;\">\n    <p style=\"font-size: 18px; color: #374151;\">Hola <strong style=\"color: #10b981;\">{{$json.nombre}}</strong>,</p>\n    \n    <p style=\"font-size: 16px; color: #6b7280; line-height: 1.6;\">¡Excelentes noticias! Tu reserva ha sido <strong style=\"color: #10b981;\">aprobada</strong> y confirmada.</p>\n    \n    <div style=\"background: #ecfdf5; padding: 20px; border-radius: 8px; margin: 20px 0; border-left: 4px solid #10b981;\">\n      <h3 style=\"margin: 0 0 15px 0; color: #065f46;\">📅 Detalles de tu evento</h3>\n      <ul style=\"list-style: none; padding: 0; margin: 0; color: #064e3b;\">\n        <li style=\"margin: 8px 0;\"><strong>📆 Fecha:</strong> {{$json.eventoFecha}}</li>\n        <li style=\"margin: 8px 0;\"><strong>⏰ Franja:</strong> {{$json.eventoFranja}}</li>\n        <li style=\"margin: 8px 0;\"><strong>👥 Invitados:</strong> {{$json.invitados}} personas</li>\n        <li style=\"margin: 8px 0;\"><strong>🎉 Tipo:</strong> {{$json.eventoTipo}}</li>\n      </ul>\n    </div>\n    \n    <div style=\"background: #fef3c7; padding: 20px; border-radius: 8px; margin: 30px 0; border-left: 4px solid #f59e0b;\">\n      <h3 style=\"margin: 0 0 10px 0; color: #92400e;\">💳 Próximo paso: Pago</h3>\n      <p style=\"margin: 0; color: #92400e; font-size: 14px; line-height: 1.6;\">\n        En breve recibirás un email con el <strong>enlace de pago seguro</strong>.<br>\n        Necesitamos un <strong>depósito del 30%</strong> para confirmar definitivamente tu reserva.<br>\n        El resto se abona el día del evento.\n      </p>\n    </div>\n    \n    <h3 style=\"color: #10b981; margin-top: 30px;\">✅ ¿Qué hemos hecho?</h3>\n    <ul style=\"color: #6b7280; line-height: 1.8;\">\n      <li>✅ Hemos bloqueado la fecha en nuestro calendario</li>\n      <li>✅ Tu evento ya está reservado</li>\n      <li>✅ Recibirás recordatorios antes del evento</li>\n    </ul>\n    \n    <div style=\"text-align: center; margin: 30px 0;\">\n      <p style=\"color: #6b7280; margin-bottom: 15px;\">¿Tienes alguna pregunta?</p>\n      <a href=\"tel:638390600\" style=\"display: inline-block; background: #00BCD4; color: white; padding: 12px 30px; text-decoration: none; border-radius: 8px; margin: 5px; font-weight: bold;\">📞 638 390 600</a>\n      <a href=\"mailto:happyhub.rovellat@gmail.com\" style=\"display: inline-block; background: #FF6B35; color: white; padding: 12px 30px; text-decoration: none; border-radius: 8px; margin: 5px; font-weight: bold;\">📧 Email</a>\n    </div>\n    \n    <p style=\"font-size: 16px; color: #374151; margin-top: 30px; text-align: center;\">\n      ¡Nos vemos pronto!<br>\n      <strong style=\"color: #10b981;\">El equipo de HappyHub</strong>\n    </p>\n  </div>\n  \n  <div style=\"text-align: center; margin-top: 30px; color: #9ca3af; font-size: 12px;\">\n    <p>HappyHub - Espacios para celebraciones</p>\n    <p>C/ Rovellat, 25, 08950 Esplugues de Llobregat (Barcelona)</p>\n  </div>\n</div>",
        "options": {}
      },
      "name": "Email - Notificar Cliente Aprobación",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1050, 300]
    }
  ],
