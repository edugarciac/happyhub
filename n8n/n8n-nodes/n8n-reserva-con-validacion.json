      "id": "create_payment_link",
      "name": "Crear Link de Pago Stripe",
      "type": "n8n-nodes-base.stripe",
      "typeVersion": 1,
      "position": [1450, 150],
      "credentials": {
        "stripeApi": {
          "id": "3",
