            "Duración": "={{$node['Normalizar Datos de Reserva'].json.duracion}}",
            "Extras": "={{$node['Normalizar Datos de Reserva'].json.extras.join(', ')}}",
            "TipoEvento": "={{$node['Normalizar Datos de Reserva'].json.tipoEvento}}",
            "MétodoPago": "={{$node['Normalizar Datos de Reserva'].json.metodoPago}}",
            "PrecioTotal": "={{$node['Normalizar Datos de Reserva'].json.precioTotal}}",
            "Estado": "Pendiente de Pago",
