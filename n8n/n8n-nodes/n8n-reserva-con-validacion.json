{
  "name": "HappyHub - Gestión de Reservas con Validación",
  "nodes": [
    {
      "parameters": {
        "path": "reserva-happyhub",
        "options": {
          "responseMode": "responseNode"
        },
        "httpMethod": "POST"
      },
      "id": "webhook_reserva",
      "name": "Webhook Reserva",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "functionCode": "// Normalizar y preparar datos de entrada\nconst body = items[0].json.body || items[0].json;\n\n// Extraer datos de reserva\nconst reservationData = {\n  nombre: body.name || body.nombre,\n  email: body.email,\n  telefono: body.phone || body.telefono,\n  fecha: body.date || body.fecha,\n  hora: body.time || body.hora,\n  pax: body.guests || body.pax,\n  duracion: body.duration || body.duracion || '4',\n  extras: body.extras || [],\n  tipoEvento: body.eventType || body.tipoEvento,\n  metodoPago: body.paymentMethod || body.metodoPago,\n  mensaje: body.message || body.mensaje || '',\n  precioTotal: body.totalPrice || body.precioTotal || 0\n};\n\n// Calcular hora de inicio y fin para búsqueda en calendario\nconst [year, month, day] = reservationData.fecha.split('-');\nconst [hours, minutes] = reservationData.hora.split(':');\n\n// Crear fecha/hora de inicio (ISO 8601)\nconst startDateTime = new Date(year, month - 1, day, hours, minutes);\n\n// Calcular fecha/hora de fin (agregar duración en horas)\nconst durationHours = parseInt(reservationData.duracion);\nconst endDateTime = new Date(startDateTime);\nendDateTime.setHours(endDateTime.getHours() + durationHours);\n\n// Formatear para Google Calendar API (RFC3339)\nconst timeMin = startDateTime.toISOString();\nconst timeMax = endDateTime.toISOString();\n\nreturn [{\n  json: {\n    ...reservationData,\n    fechaHoraInicio: startDateTime.toISOString(),\n    fechaHoraFin: endDateTime.toISOString(),\n    timeMin: timeMin,\n    timeMax: timeMax,\n    fechaFormateada: `${day}/${month}/${year}`,\n    horaFormateada: `${hours}:${minutes}h`\n  }\n}];"
      },
      "id": "normalize_data",
      "name": "Normalizar Datos de Reserva",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendarId": "primary",
        "returnAll": false,
        "options": {
          "timeMin": "={{$json.timeMin}}",
          "timeMax": "={{$json.timeMax}}",
          "maxResults": 10
        }
      },
      "id": "check_calendar",
      "name": "Verificar Disponibilidad en Calendar",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [650, 300],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "1",
          "name": "Google Calendar HappyHub"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.length || 0}}",
              "operation": "equal",
              "value2": 0
            }
          ]
        }
      },
      "id": "if_available",
      "name": "¿Fecha Disponible?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"Lo siento, la fecha y hora indicada ya está reservada.\",\n  \"message\": \"Lo siento, la fecha y hora indicada ya está reservada.\",\n  \"fechaSolicitada\": \"{{$node['Normalizar Datos de Reserva'].json.fechaFormateada}}\",\n  \"horaSolicitada\": \"{{$node['Normalizar Datos de Reserva'].json.horaFormateada}}\"\n}",
        "options": {
          "responseCode": 409
        }
      },
      "id": "response_conflict",
      "name": "Respuesta: Fecha No Disponible",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 450]
    },
    {
      "parameters": {
        "operation": "create",
        "calendarId": "primary",
        "start": "={{$node['Normalizar Datos de Reserva'].json.fechaHoraInicio}}",
        "end": "={{$node['Normalizar Datos de Reserva'].json.fechaHoraFin}}",
        "summary": "Reserva HappyHub - {{$node['Normalizar Datos de Reserva'].json.nombre}}",
        "description": "Tipo de evento: {{$node['Normalizar Datos de Reserva'].json.tipoEvento}}\\nPersonas: {{$node['Normalizar Datos de Reserva'].json.pax}}\\nTeléfono: {{$node['Normalizar Datos de Reserva'].json.telefono}}\\nEmail: {{$node['Normalizar Datos de Reserva'].json.email}}",
        "options": {
          "sendUpdates": "all"
        }
      },
      "id": "create_calendar_event",
      "name": "Crear Evento en Calendario",
