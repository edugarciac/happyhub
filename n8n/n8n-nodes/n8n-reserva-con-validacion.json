    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 300,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Genera un mensaje de confirmación amable y profesional para una reserva en HappyHub. Datos:\\n- Cliente: {{$node['Normalizar Datos de Reserva'].json.nombre}}\\n- Fecha: {{$node['Normalizar Datos de Reserva'].json.fechaFormateada}}\\n- Hora: {{$node['Normalizar Datos de Reserva'].json.horaFormateada}}\\n- Tipo de evento: {{$node['Normalizar Datos de Reserva'].json.tipoEvento}}\\n- Personas: {{$node['Normalizar Datos de Reserva'].json.pax}}\\n\\nIncluye:\\n1. Saludo personalizado\\n2. Confirmación de la reserva\\n3. Detalles del evento\\n4. Link de pago: {{$json.url}}\\n5. Recordatorio de completar el pago en 24h\\n6. Despedida cordial\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "generate_ai_message",
      "name": "Generar Mensaje con Claude AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1450, 350],
      "credentials": {
        "anthropicApi": {
          "id": "4",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Extraer el contenido del mensaje de Claude AI\nconst claudeResponse = items[0].json;\nconst messageContent = claudeResponse.content?.[0]?.text || 'Confirmación de reserva en HappyHub';\n\nreturn [{\n  json: {\n    ...items[0].json,\n    emailMessage: messageContent,\n    paymentLink: $node['Crear Link de Pago Stripe'].json.url,\n    reservationId: $node['Guardar en Airtable'].json.id\n  }\n}];"
      },
      "id": "prepare_email",
      "name": "Preparar Contenido Email",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1650, 250]
    },
    {
      "parameters": {
        "fromEmail": "no-reply@happyhub.es",
        "toEmail": "={{$node['Normalizar Datos de Reserva'].json.email}}",
        "subject": "Confirmación de tu reserva en HappyHub - {{$node['Normalizar Datos de Reserva'].json.fechaFormateada}}",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%); color: white; padding: 30px; text-align: center; border-radius: 10px 10px 0 0; }\n    .content { background: #f9f9f9; padding: 30px; border-radius: 0 0 10px 10px; }\n    .button { display: inline-block; background: #FF6B35; color: white; padding: 15px 30px; text-decoration: none; border-radius: 5px; margin: 20px 0; }\n    .details { background: white; padding: 20px; border-radius: 5px; margin: 20px 0; }\n    .footer { text-align: center; margin-top: 20px; color: #666; font-size: 12px; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>HappyHub</h1>\n      <p>Tu espacio para celebraciones inolvidables</p>\n    </div>\n    <div class=\"content\">\n      <div style=\"white-space: pre-wrap;\">{{$json.emailMessage}}</div>\n      \n      <div class=\"details\">\n        <h3>Detalles de tu reserva:</h3>\n        <p><strong>Fecha:</strong> {{$node['Normalizar Datos de Reserva'].json.fechaFormateada}}</p>\n        <p><strong>Hora:</strong> {{$node['Normalizar Datos de Reserva'].json.horaFormateada}}</p>\n        <p><strong>Duración:</strong> {{$node['Normalizar Datos de Reserva'].json.duracion}} horas</p>\n        <p><strong>Personas:</strong> {{$node['Normalizar Datos de Reserva'].json.pax}}</p>\n        <p><strong>Tipo de evento:</strong> {{$node['Normalizar Datos de Reserva'].json.tipoEvento}}</p>\n        <p><strong>Precio total:</strong> {{$node['Normalizar Datos de Reserva'].json.precioTotal}}€</p>\n      </div>\n      \n      <center>\n        <a href=\"{{$json.paymentLink}}\" class=\"button\">Completar Pago Ahora</a>\n      </center>\n      \n      <p style=\"margin-top: 20px; font-size: 14px; color: #666;\">\n        <strong>Importante:</strong> Por favor, completa el pago en las próximas 24 horas para confirmar tu reserva.\n      </p>\n      \n      <div class=\"footer\">\n        <p>¿Necesitas ayuda? Contáctanos en contacto@happyhub.es</p>\n        <p>© 2024 HappyHub - Todos los derechos reservados</p>\n      </div>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
