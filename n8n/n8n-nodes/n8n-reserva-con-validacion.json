            "metadataProperties": [
              {
                "key": "reservationId",
                "value": "={{$json.id}}"
              },
              {
                "key": "customerName",
                "value": "={{$node['Normalizar Datos de Reserva'].json.nombre}}"
              },
              {
                "key": "eventDate",
                "value": "={{$node['Normalizar Datos de Reserva'].json.fecha}}"
              },
