{
  "name": "HappyHub - Recordatorios Automáticos",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "triggerAtHour": 10
            }
          ]
        }
      },
      "id": "schedule_trigger",
      "name": "Diario 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.HAPPYHUB_URL}}/api/admin/send-reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.CRON_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "days",
              "value": "7"
            }
          ]
        },
        "options": {}
      },
      "id": "send_7_day_reminders",
      "name": "Enviar Recordatorios 7 días",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition_sent",
              "leftValue": "={{$json.sent}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check_sent",
      "name": "¿Se enviaron recordatorios?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "sendChannelMessage",
        "channel": {
          "__rl": true,
          "value": "={{$env.SLACK_CHANNEL || '#general'}}",
          "mode": "name"
        },
        "text": "=✅ *Recordatorios HappyHub enviados*\n\n📊 Resumen:\n- Total reservas: {{$json.totalReservations}}\n- Enviados: {{$json.sent}}\n- Fallidos: {{$json.failed}}\n- Omitidos: {{$json.skipped}}\n\n📅 Fecha objetivo: {{$json.targetDate}}"
      },
      "id": "slack_notification",
      "name": "Notificar en Slack (opcional)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [850, 200],
      "credentials": {
        "slackApi": {
          "id": "slack_credentials",
          "name": "Slack API"
        }
      },
      "disabled": true
    },
    {
      "parameters": {
        "functionCode": "// Log result for monitoring\nconst result = items[0].json;\n\nconsole.log('=== Recordatorios HappyHub ===');\nconsole.log(`Fecha: ${new Date().toISOString()}`);\nconsole.log(`Total reservas: ${result.totalReservations}`);\nconsole.log(`Enviados: ${result.sent}`);\nconsole.log(`Fallidos: ${result.failed}`);\nconsole.log(`Omitidos: ${result.skipped}`);\n\nreturn items;"
      },
      "id": "log_result",
      "name": "Log Resultado",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Diario 10:00": {
      "main": [
        [
          {
            "node": "Enviar Recordatorios 7 días",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Recordatorios 7 días": {
      "main": [
        [
          {
            "node": "¿Se enviaron recordatorios?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Se enviaron recordatorios?": {
      "main": [
        [
          {
            "node": "Notificar en Slack (opcional)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "HappyHub"
    },
    {
      "name": "Automatización"
    }
  ],
  "triggerCount": 1
}
